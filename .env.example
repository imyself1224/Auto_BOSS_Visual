# 复制本文件为 .env，然后填入真实 key。
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# QQ 机器人（可选）：NapCat 等 OneBot 实现里设置的 access token，没设就留空
ONEBOT_TOKEN=

# QQ 机器人（可选）：你的大号 QQ 号，只有它发来的私聊会被当成指令
OWNER_QQ=

# QQ 机器人（可选）：开放群控的群号；群里所有人 @机器人 + /指令 都能控制
QQ_GROUP_ID=
