.env
browser_profile/
# 爸妈版独立 Edge profile（登录态，不提交）
browser_profile_parents/
# 多账号数据根目录：数据库 / 日志 / 截图
data/
shots/
logs/
autoboss.db
__pycache__/
*.pyc
.venv/
config.toml.bak
_*_tmp.py

# 个人资料：简历原件与求职者画像（含真实项目经历），不上传
# 只上传示例画像 kb.example.md
resume/*
!resume/kb.example.md
.stop_request
.browser.lock
# QQ 上「/关键词 ...」设定的临时检索关键词
.qq_keywords.txt
# QQ 上「/学历 ...」「/薪资 ...」设定的筛选条件
.qq_prefs.json
.qq_prefs.json.tmp
# 当前 /切换 到的账号档位（self / parents）
.qq_active_profile

# SnowLuma（QQ 托管）：第三方程序 + 它的配置/登录数据，不上传
SnowLuma/

# 本地开发笔记 / 临时文件
进度.md
anthropic_body.txt
